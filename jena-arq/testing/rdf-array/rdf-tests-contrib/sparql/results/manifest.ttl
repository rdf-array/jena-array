@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt:   <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix ut:   <http://www.w3.org/2009/sparql/tests/test-update#> .
@prefix ra:   <https://rdf-array.github.io/rdf-array/vocab#> .

# Generated by bin/build.py -- edit the case table there.
<> a mf:Manifest ;
    rdfs:label "SPARQL-array results contrib tests" ;
    mf:entries (
        <#results-srj>
        <#results-srx>
        <#results-csv>
        <#results-tsv>
    ) .

<#results-srj> a mf:QueryEvaluationTest ;
    mf:name "results-srj" ;
    rdfs:comment "sequence bindings in the application/sparql-results+json results format" ;
    mf:requires ra:SequencePatterns, ra:SequenceResults ;
    mf:action [ qt:query <../eval/sequence-whole-binding.rq> ; qt:data <../eval/data.ttl> ] ;
    mf:result <sequences.srj> ;
    .

<#results-srx> a mf:QueryEvaluationTest ;
    mf:name "results-srx" ;
    rdfs:comment "sequence bindings in the application/sparql-results+xml results format" ;
    mf:requires ra:SequencePatterns, ra:SequenceResults ;
    mf:action [ qt:query <../eval/sequence-whole-binding.rq> ; qt:data <../eval/data.ttl> ] ;
    mf:result <sequences.srx> ;
    .

<#results-csv> a mf:CSVResultFormatTest ;
    mf:name "results-csv" ;
    rdfs:comment "sequence bindings in the text/csv results format" ;
    mf:requires ra:SequencePatterns, ra:SequenceResults ;
    mf:action [ qt:query <../eval/sequence-whole-binding.rq> ; qt:data <../eval/data.ttl> ] ;
    mf:result <sequences.csv> ;
    .

<#results-tsv> a mf:QueryEvaluationTest ;
    mf:name "results-tsv" ;
    rdfs:comment "sequence bindings in the text/tab-separated-values results format" ;
    mf:requires ra:SequencePatterns, ra:SequenceResults ;
    mf:action [ qt:query <../eval/sequence-whole-binding.rq> ; qt:data <../eval/data.ttl> ] ;
    mf:result <sequences.tsv> ;
    .
