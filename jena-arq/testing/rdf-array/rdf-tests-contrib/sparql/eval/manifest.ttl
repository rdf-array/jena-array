<#exact-sequence> a mf:QueryEvaluationTest ;
    mf:name "exact-sequence" ;
    rdfs:comment "a sequence term in a pattern matches an equal sequence" ;
    mf:requires ra:SequencePatterns ;
    mf:action [ qt:query <exact-sequence.rq> ; qt:data <data.ttl> ] ;
    mf:result <exact-sequence.srj> ;
    .

