<#exact-sequence> a mf:QueryEvaluationTest ;
    mf:name "exact-sequence" ;
    rdfs:comment "a sequence term in a pattern matches an equal sequence" ;
    mf:requires ra:SequencePatterns ;
    mf:action [ qt:query <exact-sequence.rq> ; qt:data <data.ttl> ] ;
    mf:result <exact-sequence.srj> ;
    .

<#sequence-variables> a mf:QueryEvaluationTest ;
    mf:name "sequence-variables" ;
    rdfs:comment "variables inside a sequence bind to its elements" ;
    mf:requires ra:SequencePatterns ;
    mf:action [ qt:query <sequence-variables.rq> ; qt:data <data.ttl> ] ;
    mf:result <sequence-variables.srj> ;
    .

<#sequence-length-mismatch> a mf:QueryEvaluationTest ;
