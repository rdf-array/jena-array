@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt:   <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix ut:   <http://www.w3.org/2009/sparql/tests/test-update#> .
@prefix ra:   <https://rdf-array.github.io/rdf-array/vocab#> .

# Generated by bin/build.py -- edit the case table there.
<> a mf:Manifest ;
    rdfs:label "SPARQL-array update contrib tests" ;
    mf:entries (
        <#insert-data-sequence>
        <#delete-data-sequence>
        <#delete-where-position>
        <#undef-insert-data>
        <#undef-delete-data>
        <#undef-insert-where>
        <#undef-delete-where>
    ) .

<#insert-data-sequence> a mf:UpdateEvaluationTest ;
    mf:name "insert-data-sequence" ;
    rdfs:comment "INSERT DATA inserts sequence terms" ;
    mf:requires ra:SequencePatterns ;
    mf:action [ ut:request <insert-data-sequence.ru> ; ut:data <insert-data-sequence-pre.ttl> ] ;
    mf:result [ ut:data <insert-data-sequence-post.nt> ] ;
    .

<#delete-data-sequence> a mf:UpdateEvaluationTest ;
    mf:name "delete-data-sequence" ;
    rdfs:comment "DELETE DATA removes the triple with an equal sequence" ;
    mf:requires ra:SequencePatterns ;
    mf:action [ ut:request <delete-data-sequence.ru> ; ut:data <delete-data-sequence-pre.ttl> ] ;
    mf:result [ ut:data <delete-data-sequence-post.nt> ] ;
    .

<#delete-where-position> a mf:UpdateEvaluationTest ;
    mf:name "delete-where-position" ;
    rdfs:comment "spread a sequence into repeated properties with UNNEST" ;
    mf:requires ra:SequencePatterns, ra:Unnest ;
    mf:action [ ut:request <delete-where-position.ru> ; ut:data <delete-where-position-pre.ttl> ] ;
    mf:result [ ut:data <delete-where-position-post.nt> ] ;
    .

<#undef-insert-data> a mf:UpdateEvaluationTest ;
    mf:name "undef-insert-data" ;
    rdfs:comment "INSERT DATA with a slot" ;
    mf:requires ra:SequencePatterns, ra:UndefSlots ;
    mf:action [ ut:request <undef-insert-data.ru> ; ut:data <undef-insert-data-pre.ttl> ] ;
    mf:result [ ut:data <undef-insert-data-post.nt> ] ;
    .

<#undef-delete-data> a mf:UpdateEvaluationTest ;
    mf:name "undef-delete-data" ;
    rdfs:comment "DELETE DATA removes the triple with the slot, and not one with a value there" ;
    mf:requires ra:SequencePatterns, ra:UndefSlots ;
    mf:action [ ut:request <undef-delete-data.ru> ; ut:data <undef-delete-data-pre.ttl> ] ;
    mf:result [ ut:data <undef-delete-data-post.nt> ] ;
    .

<#undef-insert-where> a mf:UpdateEvaluationTest ;
    mf:name "undef-insert-where" ;
    rdfs:comment "INSERT: an unbound variable in a template sequence writes a slot" ;
    mf:requires ra:SequencePatterns, ra:UndefSlots ;
    mf:action [ ut:request <undef-insert-where.ru> ; ut:data <undef-insert-where-pre.ttl> ] ;
    mf:result [ ut:data <undef-insert-where-post.nt> ] ;
    .

<#undef-delete-where> a mf:UpdateEvaluationTest ;
    mf:name "undef-delete-where" ;
    rdfs:comment "DELETE with undef in the pattern and the template" ;
    mf:requires ra:SequencePatterns, ra:UndefSlots ;
    mf:action [ ut:request <undef-delete-where.ru> ; ut:data <undef-delete-where-pre.ttl> ] ;
    mf:result [ ut:data <undef-delete-where-post.nt> ] ;
    .
