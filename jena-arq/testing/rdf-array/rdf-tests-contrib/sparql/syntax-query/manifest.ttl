<#bad-sequence-predicate> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-sequence-predicate" ;
    rdfs:comment "a sequence is not a predicate" ;
    mf:requires ra:SequencePatterns ;
    mf:action <bad-sequence-predicate.rq> ;
    .

<#bad-position-empty-brackets> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-position-empty-brackets" ;
    rdfs:comment "a position pattern needs a position" ;
    mf:requires ra:SequencePatterns, ra:PositionPatterns ;
    mf:action <bad-position-empty-brackets.rq> ;
    .

<#bad-position-decimal> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-position-decimal" ;
    rdfs:comment "a position is an integer, a variable or *" ;
    mf:requires ra:SequencePatterns, ra:PositionPatterns ;
    mf:action <bad-position-decimal.rq> ;
    .

<#syntax-exact-sequence> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-exact-sequence" ;
    rdfs:comment "a sequence term in a pattern matches an equal sequence" ;
    mf:requires ra:SequencePatterns ;
    mf:action <../eval/exact-sequence.rq> ;
    .

<#syntax-sequence-variables> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-sequence-variables" ;
    rdfs:comment "variables inside a sequence bind to its elements" ;
    mf:requires ra:SequencePatterns ;
    mf:action <../eval/sequence-variables.rq> ;
    .

<#syntax-sequence-length-mismatch> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-sequence-length-mismatch" ;
    rdfs:comment "a pattern of another length does not match" ;
    mf:requires ra:SequencePatterns ;
    mf:action <../eval/sequence-length-mismatch.rq> ;
    .

<#syntax-sequence-repeated-variable-length> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-sequence-repeated-variable-length" ;
    rdfs:comment "a repeated variable must match equal elements" ;
    mf:requires ra:SequencePatterns ;
    mf:action <../eval/sequence-repeated-variable-length.rq> ;
    .

<#syntax-sequence-repeated-variable> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-sequence-repeated-variable" ;
    rdfs:comment "a repeated variable binds once" ;
    mf:requires ra:SequencePatterns ;
    mf:action <../eval/sequence-repeated-variable.rq> ;
    .

<#syntax-sequence-nested> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-sequence-nested" ;
    rdfs:comment "variables inside a nested sequence" ;
    mf:requires ra:SequencePatterns ;
    mf:action <../eval/sequence-nested.rq> ;
    .

<#syntax-sequence-empty> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-sequence-empty" ;
    rdfs:comment "() matches the empty sequence" ;
    mf:requires ra:SequencePatterns ;
    mf:action <../eval/sequence-empty.rq> ;
    .

<#syntax-sequence-whole-binding> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-sequence-whole-binding" ;
    rdfs:comment "a variable binds a whole sequence; the results carry sequence terms" ;
    mf:requires ra:SequencePatterns ;
    mf:action <../eval/sequence-whole-binding.rq> ;
    .

<#syntax-sequence-order-by> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-sequence-order-by" ;
