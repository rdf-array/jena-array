<#bad-sequence-predicate> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-sequence-predicate" ;
    rdfs:comment "a sequence is not a predicate" ;
    mf:requires ra:SequencePatterns ;
    mf:action <bad-sequence-predicate.rq> ;
    .

<#bad-slice-colon> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-slice-colon" ;
    rdfs:comment "a slice is [m...n]: in [2:4], :4 is a prefixed name" ;
    mf:requires ra:SequencePatterns, ra:SequenceFunctions ;
    mf:action <bad-slice-colon.rq> ;
    .

<#bad-slice-no-ends> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-slice-no-ends" ;
    rdfs:comment "a slice needs at least one end" ;
    mf:requires ra:SequencePatterns, ra:SequenceFunctions ;
    mf:action <bad-slice-no-ends.rq> ;
    .

<#bad-gap-in-template> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-gap-in-template" ;
    rdfs:comment "a gap is a pattern: a template builds a sequence and may not hold one" ;
    mf:requires ra:SequencePatterns, ra:GapPatterns ;
    mf:action <bad-gap-in-template.rq> ;
    .

<#bad-unnest-without-as> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-unnest-without-as" ;
    rdfs:comment "UNNEST binds its member with AS" ;
    mf:requires ra:SequencePatterns, ra:Unnest ;
    mf:action <bad-unnest-without-as.rq> ;
    .

<#bad-old-position-pattern> a mf:NegativeSyntaxTest11 ;
    mf:name "bad-old-position-pattern" ;
    rdfs:comment "the former ((e))[i] position pattern is no longer syntax" ;
    mf:requires ra:SequencePatterns ;
    mf:action <bad-old-position-pattern.rq> ;
    .

<#syntax-gap-lexing> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-gap-lexing" ;
    rdfs:comment "1... and :a... are a member then a gap; :a...b is one prefixed name" ;
    mf:requires ra:SequencePatterns, ra:GapPatterns ;
    mf:action <syntax-gap-lexing.rq> ;
    .

<#syntax-gap-named-or-not> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-gap-named-or-not" ;
    rdfs:comment "( ?a ... ?b ) is a gap then a member; ( ?a ...?b ) is a named gap" ;
    mf:requires ra:SequencePatterns, ra:GapPatterns ;
    mf:action <syntax-gap-named-or-not.rq> ;
    .

<#syntax-gaps-nested> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-gaps-nested" ;
    rdfs:comment "gaps nest" ;
