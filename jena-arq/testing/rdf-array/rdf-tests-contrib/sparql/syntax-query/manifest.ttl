    .

<#syntax-position-out-of-range> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-position-out-of-range" ;
    rdfs:comment "a position past the end matches nothing" ;
    mf:requires ra:SequencePatterns, ra:PositionPatterns ;
    mf:action <../eval/position-out-of-range.rq> ;
    .

<#syntax-position-variable> a mf:PositiveSyntaxTest11 ;
    mf:name "syntax-position-variable" ;
    rdfs:comment "((x))[?i]: every element, with its 1-based position" ;
