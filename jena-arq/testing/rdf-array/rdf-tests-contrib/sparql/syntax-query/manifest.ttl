    rdfs:comment "isSEQ is false for other terms" ;
    mf:requires ra:SequencePatterns, ra:SequenceFunctions ;
    mf:action <../eval/function-isseq-false.rq> ;
    .

<#syntax-function-chained-index> a mf:PositiveSyntaxTest11 ;
