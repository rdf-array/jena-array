@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdft: <http://www.w3.org/ns/rdftest#> .
@prefix ra:   <https://rdf-array.github.io/rdf-array/vocab#> .

# Generated by bin/build.py -- edit the case table there.
<> a mf:Manifest ;
    rdfs:label "rdf-array rdf-turtle contrib tests" ;
    mf:assumedTestBase <https://rdf-array.github.io/rdf-tests-contrib/rdf/rdf-turtle/> ;
    mf:entries (
        <#seq-object>
        <#seq-empty>
        <#seq-nil-is-not-empty>
        <#seq-nested-and-bnode-property-list>
        <#seq-subject>
        <#seq-subject-and-object>
        <#seq-mixed-elements>
        <#seq-nested-empties>
        <#seq-of-blank-nodes>
        <#seq-equal-terms>
        <#seq-in-bnode-property-list-subject>
        <#seq-literal-kinds>
        <#explicit-ladder-stays-triples>
        <#bad-seq-predicate>
        <#bad-seq-unclosed>
        <#bad-seq-comma>
    ) .

<#seq-object> a rdft:TestTurtleEval ;
    mf:name "seq-object" ;
    rdfs:comment "a collection in object position is one sequence term" ;
    mf:requires ra:Sequences ;
    mf:action <seq-object.ttl> ;
    mf:result <seq-object.nt> ;
    .

<#seq-empty> a rdft:TestTurtleEval ;
    mf:name "seq-empty" ;
    rdfs:comment "() is the empty sequence, not rdf:nil" ;
    mf:requires ra:Sequences ;
    mf:action <seq-empty.ttl> ;
    mf:result <seq-empty.nt> ;
    .

<#seq-nil-is-not-empty> a rdft:TestTurtleEval ;
    mf:name "seq-nil-is-not-empty" ;
    rdfs:comment "rdf:nil and () are two different terms" ;
    mf:requires ra:Sequences ;
    mf:action <seq-nil-is-not-empty.ttl> ;
    mf:result <seq-nil-is-not-empty.nt> ;
    .

<#seq-nested-and-bnode-property-list> a rdft:TestTurtleEval ;
    mf:name "seq-nested-and-bnode-property-list" ;
    rdfs:comment "a nested sequence and a blank node property list as elements; the property list still contributes its triple" ;
    mf:requires ra:Sequences ;
    mf:action <seq-nested-and-bnode-property-list.ttl> ;
    mf:result <seq-nested-and-bnode-property-list.nt> ;
    .

<#seq-subject> a rdft:TestTurtleEval ;
    mf:name "seq-subject" ;
    rdfs:comment "a sequence as subject" ;
    mf:requires ra:Sequences ;
    mf:action <seq-subject.ttl> ;
    mf:result <seq-subject.nt> ;
    .

<#seq-subject-and-object> a rdft:TestTurtleEval ;
    mf:name "seq-subject-and-object" ;
    rdfs:comment "sequences as subject and object of one triple" ;
    mf:requires ra:Sequences ;
    mf:action <seq-subject-and-object.ttl> ;
    mf:result <seq-subject-and-object.nt> ;
    .

<#seq-mixed-elements> a rdft:TestTurtleEval ;
    mf:name "seq-mixed-elements" ;
    rdfs:comment "elements of every kind, an empty sequence, and a one-element sequence as subject" ;
    mf:requires ra:Sequences ;
    mf:action <seq-mixed-elements.ttl> ;
    mf:result <seq-mixed-elements.nt> ;
    .

<#seq-nested-empties> a rdft:TestTurtleEval ;
    mf:name "seq-nested-empties" ;
    rdfs:comment "empty sequences nested at three depths" ;
    mf:requires ra:Sequences ;
    mf:action <seq-nested-empties.ttl> ;
    mf:result <seq-nested-empties.nt> ;
    .

<#seq-of-blank-nodes> a rdft:TestTurtleEval ;
    mf:name "seq-of-blank-nodes" ;
    rdfs:comment "blank nodes, anonymous or labelled, as elements" ;
    mf:requires ra:Sequences ;
    mf:action <seq-of-blank-nodes.ttl> ;
    mf:result <seq-of-blank-nodes.nt> ;
    .

<#seq-equal-terms> a rdft:TestTurtleEval ;
    mf:name "seq-equal-terms" ;
    rdfs:comment "two equal sequences are one term" ;
    mf:requires ra:Sequences ;
    mf:action <seq-equal-terms.ttl> ;
    mf:result <seq-equal-terms.nt> ;
    .

<#seq-in-bnode-property-list-subject> a rdft:TestTurtleEval ;
    mf:name "seq-in-bnode-property-list-subject" ;
    rdfs:comment "a sequence inside a blank node property list used as subject" ;
    mf:requires ra:Sequences ;
    mf:action <seq-in-bnode-property-list-subject.ttl> ;
    mf:result <seq-in-bnode-property-list-subject.nt> ;
    .

<#seq-literal-kinds> a rdft:TestTurtleEval ;
    mf:name "seq-literal-kinds" ;
    rdfs:comment "abbreviated literals as elements" ;
    mf:requires ra:Sequences ;
    mf:action <seq-literal-kinds.ttl> ;
    mf:result <seq-literal-kinds.nt> ;
    .

<#explicit-ladder-stays-triples> a rdft:TestTurtleEval ;
    mf:name "explicit-ladder-stays-triples" ;
    rdfs:comment "rdf:first and rdf:rest written as properties are ordinary triples, not a sequence" ;
    mf:requires ra:Sequences ;
    mf:action <explicit-ladder-stays-triples.ttl> ;
    mf:result <explicit-ladder-stays-triples.nt> ;
    .

<#bad-seq-predicate> a rdft:TestTurtleNegativeSyntax ;
    mf:name "bad-seq-predicate" ;
    rdfs:comment "a sequence is not a predicate" ;
    mf:requires ra:Sequences ;
    mf:action <bad-seq-predicate.ttl> ;
    .

<#bad-seq-unclosed> a rdft:TestTurtleNegativeSyntax ;
    mf:name "bad-seq-unclosed" ;
    rdfs:comment "an unclosed sequence" ;
    mf:requires ra:Sequences ;
    mf:action <bad-seq-unclosed.ttl> ;
    .

<#bad-seq-comma> a rdft:TestTurtleNegativeSyntax ;
    mf:name "bad-seq-comma" ;
    rdfs:comment "elements are not separated by commas" ;
    mf:requires ra:Sequences ;
    mf:action <bad-seq-comma.ttl> ;
    .
