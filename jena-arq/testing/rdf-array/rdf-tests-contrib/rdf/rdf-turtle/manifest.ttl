    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nested-subject.ttl> ;
    mf:result <undef-nested-subject.nt> ;
    .

<#undef-prefixed-name> a rdft:TestTurtleEval ;
    mf:name "undef-prefixed-name" ;
