<#undef-object> a rdft:TestTurtleEval ;
    mf:name "undef-object" ;
    rdfs:comment "undef is an empty slot: the sequence has three positions and nothing at the second" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-object.ttl> ;
    mf:result <undef-object.nt> ;
    .

<#undef-only> a rdft:TestTurtleEval ;
    mf:name "undef-only" ;
    rdfs:comment "sequences of nothing but slots have a length" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-only.ttl> ;
