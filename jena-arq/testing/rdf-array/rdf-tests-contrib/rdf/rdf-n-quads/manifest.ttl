@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdft: <http://www.w3.org/ns/rdftest#> .
@prefix ra:   <https://rdf-array.github.io/rdf-array/vocab#> .

# Generated by bin/build.py -- edit the case table there.
<> a mf:Manifest ;
    rdfs:label "rdf-array rdf-n-quads contrib tests" ;
    mf:assumedTestBase <https://rdf-array.github.io/rdf-tests-contrib/rdf/rdf-n-quads/> ;
    mf:entries (
        <#nq-seq-object-in-graph>
        <#nq-bad-seq-graph-label>
        <#undef-nq-object-in-graph>
        <#undef-nq-bad-graph-label>
        <#undef-nq-bad-object>
    ) .

<#nq-seq-object-in-graph> a rdft:TestNQuadsPositiveSyntax ;
    mf:name "nq-seq-object-in-graph" ;
    rdfs:comment "N-Quads-array: a sequence object in a named graph" ;
    mf:requires ra:Sequences ;
    mf:action <nq-seq-object-in-graph.nq> ;
    .

<#nq-bad-seq-graph-label> a rdft:TestNQuadsNegativeSyntax ;
    mf:name "nq-bad-seq-graph-label" ;
    rdfs:comment "a sequence is not a graph label" ;
    mf:requires ra:Sequences ;
    mf:action <nq-bad-seq-graph-label.nq> ;
    .

<#undef-nq-object-in-graph> a rdft:TestNQuadsPositiveSyntax ;
    mf:name "undef-nq-object-in-graph" ;
    rdfs:comment "N-Quads-array: a slot in a sequence in a named graph" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nq-object-in-graph.nq> ;
    .

<#undef-nq-bad-graph-label> a rdft:TestNQuadsNegativeSyntax ;
    mf:name "undef-nq-bad-graph-label" ;
    rdfs:comment "a slot is not a graph label" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nq-bad-graph-label.nq> ;
    .

<#undef-nq-bad-object> a rdft:TestNQuadsNegativeSyntax ;
    mf:name "undef-nq-bad-object" ;
    rdfs:comment "a slot is not an object" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nq-bad-object.nq> ;
    .
