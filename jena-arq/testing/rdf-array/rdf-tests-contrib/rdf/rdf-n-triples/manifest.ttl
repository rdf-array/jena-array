@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdft: <http://www.w3.org/ns/rdftest#> .
@prefix ra:   <https://rdf-array.github.io/rdf-array/vocab#> .

# Generated by bin/build.py -- edit the case table there.
<> a mf:Manifest ;
    rdfs:label "rdf-array rdf-n-triples contrib tests" ;
    mf:assumedTestBase <https://rdf-array.github.io/rdf-tests-contrib/rdf/rdf-n-triples/> ;
    mf:entries (
        <#nt-seq-object>
        <#nt-seq-subject>
        <#nt-seq-nested-bnode>
        <#nt-bad-seq-predicate>
        <#nt-bad-seq-unclosed>
        <#nt-bad-seq-prefixed-name>
        <#undef-nt-object>
        <#undef-nt-subject>
        <#undef-nt-case>
        <#undef-nt-bad-object>
        <#undef-nt-bad-subject>
        <#undef-nt-bad-predicate>
    ) .

<#nt-seq-object> a rdft:TestNTriplesPositiveSyntax ;
    mf:name "nt-seq-object" ;
    rdfs:comment "N-Triples-array: a sequence of a literal, an IRI and the empty sequence" ;
    mf:requires ra:Sequences ;
    mf:action <nt-seq-object.nt> ;
    .

<#nt-seq-subject> a rdft:TestNTriplesPositiveSyntax ;
    mf:name "nt-seq-subject" ;
    rdfs:comment "N-Triples-array: a sequence as subject" ;
    mf:requires ra:Sequences ;
    mf:action <nt-seq-subject.nt> ;
    .

<#nt-seq-nested-bnode> a rdft:TestNTriplesPositiveSyntax ;
    mf:name "nt-seq-nested-bnode" ;
    rdfs:comment "N-Triples-array: a blank node inside nested sequences" ;
    mf:requires ra:Sequences ;
    mf:action <nt-seq-nested-bnode.nt> ;
    .

<#nt-bad-seq-predicate> a rdft:TestNTriplesNegativeSyntax ;
    mf:name "nt-bad-seq-predicate" ;
    rdfs:comment "a sequence is not a predicate" ;
    mf:requires ra:Sequences ;
    mf:action <nt-bad-seq-predicate.nt> ;
    .

<#nt-bad-seq-unclosed> a rdft:TestNTriplesNegativeSyntax ;
    mf:name "nt-bad-seq-unclosed" ;
    rdfs:comment "an unclosed sequence" ;
    mf:requires ra:Sequences ;
    mf:action <nt-bad-seq-unclosed.nt> ;
    .

<#nt-bad-seq-prefixed-name> a rdft:TestNTriplesNegativeSyntax ;
    mf:name "nt-bad-seq-prefixed-name" ;
    rdfs:comment "N-Triples has no prefixed names, inside sequences either" ;
    mf:requires ra:Sequences ;
    mf:action <nt-bad-seq-prefixed-name.nt> ;
    .

<#undef-nt-object> a rdft:TestNTriplesPositiveSyntax ;
    mf:name "undef-nt-object" ;
    rdfs:comment "N-Triples-array: a slot as a member, at two depths" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nt-object.nt> ;
    .

<#undef-nt-subject> a rdft:TestNTriplesPositiveSyntax ;
    mf:name "undef-nt-subject" ;
    rdfs:comment "N-Triples-array: a slot in a sequence as subject" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nt-subject.nt> ;
    .

<#undef-nt-case> a rdft:TestNTriplesPositiveSyntax ;
    mf:name "undef-nt-case" ;
    rdfs:comment "N-Triples-array: undef in any case" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nt-case.nt> ;
    .

<#undef-nt-bad-object> a rdft:TestNTriplesNegativeSyntax ;
    mf:name "undef-nt-bad-object" ;
    rdfs:comment "a slot is not an object" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nt-bad-object.nt> ;
    .

<#undef-nt-bad-subject> a rdft:TestNTriplesNegativeSyntax ;
    mf:name "undef-nt-bad-subject" ;
    rdfs:comment "a slot is not a subject" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nt-bad-subject.nt> ;
    .

<#undef-nt-bad-predicate> a rdft:TestNTriplesNegativeSyntax ;
    mf:name "undef-nt-bad-predicate" ;
    rdfs:comment "a slot is not a predicate" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-nt-bad-predicate.nt> ;
    .
