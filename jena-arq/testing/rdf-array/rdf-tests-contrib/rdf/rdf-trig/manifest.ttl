@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdft: <http://www.w3.org/ns/rdftest#> .
@prefix ra:   <https://rdf-array.github.io/rdf-array/vocab#> .

# Generated by bin/build.py -- edit the case table there.
<> a mf:Manifest ;
    rdfs:label "rdf-array rdf-trig contrib tests" ;
    mf:assumedTestBase <https://rdf-array.github.io/rdf-tests-contrib/rdf/rdf-trig/> ;
    mf:entries (
        <#trig-seq-in-graph>
        <#trig-seq-subject-in-graph>
        <#trig-bad-seq-graph-name>
        <#undef-trig-in-graph>
        <#undef-trig-bad-graph-name>
        <#undef-trig-bad-object>
    ) .

<#trig-seq-in-graph> a rdft:TestTrigEval ;
    mf:name "trig-seq-in-graph" ;
    rdfs:comment "a sequence in a named graph" ;
    mf:requires ra:Sequences ;
    mf:action <trig-seq-in-graph.trig> ;
    mf:result <trig-seq-in-graph.nq> ;
    .

<#trig-seq-subject-in-graph> a rdft:TestTrigEval ;
    mf:name "trig-seq-subject-in-graph" ;
    rdfs:comment "sequences as subject and object in a named graph" ;
    mf:requires ra:Sequences ;
    mf:action <trig-seq-subject-in-graph.trig> ;
    mf:result <trig-seq-subject-in-graph.nq> ;
    .

<#trig-bad-seq-graph-name> a rdft:TestTrigNegativeSyntax ;
    mf:name "trig-bad-seq-graph-name" ;
    rdfs:comment "a sequence is not a graph name" ;
    mf:requires ra:Sequences ;
    mf:action <trig-bad-seq-graph-name.trig> ;
    .

<#undef-trig-in-graph> a rdft:TestTrigEval ;
    mf:name "undef-trig-in-graph" ;
    rdfs:comment "slots in sequences in a named graph" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-trig-in-graph.trig> ;
    mf:result <undef-trig-in-graph.nq> ;
    .

<#undef-trig-bad-graph-name> a rdft:TestTrigNegativeSyntax ;
    mf:name "undef-trig-bad-graph-name" ;
    rdfs:comment "a slot is not a graph name" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-trig-bad-graph-name.trig> ;
    .

<#undef-trig-bad-object> a rdft:TestTrigNegativeSyntax ;
    mf:name "undef-trig-bad-object" ;
    rdfs:comment "a slot is not an object" ;
    mf:requires ra:Sequences, ra:UndefSlots ;
    mf:action <undef-trig-bad-object.trig> ;
    .
