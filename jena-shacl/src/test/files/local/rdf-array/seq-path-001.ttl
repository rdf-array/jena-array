## rdf-array: a SHACL list is a sequence term, ( ... ); () is the empty list.

PREFIX ex: <http://jena.apache.org/shacl/tests/rdf-array/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:SeqPathShape
  rdf:type sh:NodeShape ;
  sh:targetNode ex:a, ex:c ;
  sh:property [ sh:path ( ex:p ex:q ) ; sh:datatype xsd:string ] .

ex:a ex:p ex:b .
ex:b ex:q "fine" .
ex:c ex:p ex:d .
ex:d ex:q 1 .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <seq-path-001> )
.

<seq-path-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: a sequence path is a sequence term" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result <report> .

<report>
    a            sh:ValidationReport ;
    sh:conforms  false ;
    sh:result    [ sh:focusNode                  ex:c ;
                   sh:resultPath                 ( ex:p ex:q ) ;
                   sh:resultSeverity             sh:Violation ;
                   sh:sourceConstraintComponent  sh:DatatypeConstraintComponent ;
                   sh:value                      1
                 ] .
