PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetNode ex:a, ex:b ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property ex:S-p .
ex:S-p sh:path ex:p .
ex:a a ex:C ; ex:p 1 .
ex:b ex:p 1 ; ex:q 2 .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <seq-closed-ignored-001> ) ;
.

<seq-closed-ignored-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: sh:ignoredProperties takes a sequence term" ;
  mf:requires ra:Sequences ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:b ;
          sh:resultPath ex:q ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClosedConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
