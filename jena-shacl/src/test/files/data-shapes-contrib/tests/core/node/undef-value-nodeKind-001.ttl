PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetNode ex:a ; sh:property ex:S-p .
ex:S-p sh:path ex:p ; sh:nodeKind sh:IRI ; sh:minCount 2 .
ex:a ex:p ( 1 undef ) .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <undef-value-nodeKind-001> ) ;
.

<undef-value-nodeKind-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: a sequence holding a slot is a value like any other sequence" ;
  mf:requires ra:Sequences ;
  mf:requires ra:UndefSlots ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:a ;
          sh:resultPath ex:p ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
          sh:sourceShape ex:S-p ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:a ;
          sh:resultPath ex:p ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:NodeKindConstraintComponent ;
          sh:sourceShape ex:S-p ;
          sh:value ("1"^^<http://www.w3.org/2001/XMLSchema#integer> undef) ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
