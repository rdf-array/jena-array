PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:A a sh:NodeShape .
ex:S a sh:NodeShape ; sh:targetNode ex:a ; sh:or ( ex:A undef ) .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <undef-or-001> ) ;
.

<undef-or-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: a slot in sh:or is ill-formed" ;
  mf:requires ra:Sequences ;
  mf:requires ra:UndefSlots ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
