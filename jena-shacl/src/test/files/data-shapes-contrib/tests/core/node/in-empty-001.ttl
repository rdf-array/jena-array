PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:TestInUnsatisfiableShape a sh:NodeShape ; sh:in () .
ex:InSubjectsShape a sh:NodeShape ; sh:targetSubjectsOf sh:in ; sh:property ex:InSubjectsShape-in .
ex:InSubjectsShape-in a sh:PropertyShape ; sh:path sh:in ; sh:minListLength 1 ; sh:severity sh:Warning .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <in-empty-001> ) ;
.

<in-empty-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: sh:in () is the empty list; a warning shape with sh:minListLength 1 reports it (counterpart of SHACL 1.2 in-003)" ;
  mf:requires ra:Sequences ;
  mf:requires ra:ShaclListConstraints ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:TestInUnsatisfiableShape ;
          sh:resultPath sh:in ;
          sh:resultSeverity sh:Warning ;
          sh:sourceConstraintComponent sh:MinListLengthConstraintComponent ;
          sh:sourceShape ex:InSubjectsShape-in ;
          sh:value () ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
