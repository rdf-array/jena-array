PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ;
  sh:targetNode 1, 3, "x", true ;
  sh:or ( ex:InShape ex:StringShape ) ;
  sh:not ex:ThreeShape .
ex:InShape a sh:NodeShape ; sh:in ( 1 2 3 ) .
ex:StringShape a sh:NodeShape ; sh:datatype xsd:string .
ex:ThreeShape a sh:NodeShape ; sh:in ( 3 ) .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <seq-in-or-001> ) ;
.

<seq-in-or-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: sh:in, sh:or and sh:not take sequence terms" ;
  mf:requires ra:Sequences ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode "3"^^<http://www.w3.org/2001/XMLSchema#integer> ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:NotConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value "3"^^<http://www.w3.org/2001/XMLSchema#integer> ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:OrConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
