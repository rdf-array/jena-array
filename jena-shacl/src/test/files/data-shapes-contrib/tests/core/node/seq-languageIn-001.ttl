PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetNode "a"@en, "b"@fr, "c"@de ; sh:languageIn ( "en" "fr" ) .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <seq-languageIn-001> ) ;
.

<seq-languageIn-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: sh:languageIn takes a sequence term" ;
  mf:requires ra:Sequences ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode "c"@de ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:LanguageInConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value "c"@de ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
