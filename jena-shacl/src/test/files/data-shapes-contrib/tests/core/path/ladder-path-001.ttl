PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetNode ex:a ; sh:property ex:S-p .
ex:S-p sh:path [ rdf:first ex:p ; rdf:rest ( ex:q ) ] ; sh:minCount 1 .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <ladder-path-001> ) ;
.

<ladder-path-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: a path written as an rdf:first/rdf:rest ladder of blank nodes is not a sequence path, and a blank node with no path property is no path: the shapes graph is ill-formed" ;
  mf:requires ra:Sequences ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
