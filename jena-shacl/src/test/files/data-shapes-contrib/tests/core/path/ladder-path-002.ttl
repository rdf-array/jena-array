PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetNode ex:a ; sh:property ex:S-p .
ex:S-p sh:path ex:l1 ; sh:minCount 1 .
ex:l1 rdf:first ex:p ; rdf:rest ( ex:q ) .
ex:a ex:p ex:b . ex:b ex:q ex:c .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <ladder-path-002> ) ;
.

<ladder-path-002>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: an IRI written as the head of an rdf:first/rdf:rest ladder is, as a path, the predicate path of that IRI" ;
  mf:requires ra:Sequences ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:a ;
          sh:resultPath ex:l1 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
          sh:sourceShape ex:S-p ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
