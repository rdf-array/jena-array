PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetNode ex:a ; sh:property ex:S-p .
ex:S-p sh:path [ sh:alternativePath ( ex:p ( ex:q ex:r ) ) ] ; sh:class ex:C .
ex:a ex:p ex:b ; ex:q ex:c . ex:c ex:r ex:d .
ex:b a ex:C .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <seq-path-alternative-nested-001> ) ;
.

<seq-path-alternative-nested-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: an alternative path whose second member is a sequence path" ;
  mf:requires ra:Sequences ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:a ;
          sh:resultPath [ sh:alternativePath ( ex:p ( ex:q ex:r ) ) ] ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClassConstraintComponent ;
          sh:sourceShape ex:S-p ;
          sh:value ex:d ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
