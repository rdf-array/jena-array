PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetNode ex:a, ex:b ; sh:property ex:S-p .
ex:S-p sh:path rdf:nil ; sh:minCount 1 .
ex:a rdf:nil 1 .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <nil-predicate-path-001> ) ;
.

<nil-predicate-path-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: rdf:nil is an IRI, so sh:path rdf:nil is a predicate path, not an empty sequence path" ;
  mf:requires ra:Sequences ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:b ;
          sh:resultPath rdf:nil ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
          sh:sourceShape ex:S-p ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
