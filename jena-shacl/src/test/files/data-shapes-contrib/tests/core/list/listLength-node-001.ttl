<listLength-node-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: sh:minListLength and sh:maxListLength on focus nodes that are sequences (counterpart of SHACL 1.2 node/minListLength-001 and maxListLength-001)" ;
  mf:requires ra:Sequences ;
  mf:requires ra:ShaclListConstraints ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ("1"^^<http://www.w3.org/2001/XMLSchema#integer> "2"^^<http://www.w3.org/2001/XMLSchema#integer> "3"^^<http://www.w3.org/2001/XMLSchema#integer>) ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MaxListLengthConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value ("1"^^<http://www.w3.org/2001/XMLSchema#integer> "2"^^<http://www.w3.org/2001/XMLSchema#integer> "3"^^<http://www.w3.org/2001/XMLSchema#integer>) ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode () ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinListLengthConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value () ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:notAList ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MaxListLengthConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value ex:notAList ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:notAList ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinListLengthConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value ex:notAList ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
