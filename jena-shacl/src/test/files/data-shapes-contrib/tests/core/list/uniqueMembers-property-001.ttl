PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetNode ex:a, ex:b, ex:c, ex:d ; sh:property ex:S-p .
ex:S-p sh:path ex:p ; sh:uniqueMembers true .
ex:a ex:p ( 1 2 ) .
ex:b ex:p ( 1 2 1 ) .
ex:c ex:p () .
ex:d ex:p ( ( 1 ) ( 1 ) ) .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <uniqueMembers-property-001> ) ;
.

<uniqueMembers-property-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: sh:uniqueMembers on the values of a property" ;
  mf:requires ra:Sequences ;
  mf:requires ra:ShaclListConstraints ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:b ;
          sh:resultPath ex:p ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:UniqueMembersConstraintComponent ;
          sh:sourceShape ex:S-p ;
          sh:value ("1"^^<http://www.w3.org/2001/XMLSchema#integer> "2"^^<http://www.w3.org/2001/XMLSchema#integer> "1"^^<http://www.w3.org/2001/XMLSchema#integer>) ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:d ;
          sh:resultPath ex:p ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:UniqueMembersConstraintComponent ;
          sh:sourceShape ex:S-p ;
          sh:value (("1"^^<http://www.w3.org/2001/XMLSchema#integer>) ("1"^^<http://www.w3.org/2001/XMLSchema#integer>)) ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
