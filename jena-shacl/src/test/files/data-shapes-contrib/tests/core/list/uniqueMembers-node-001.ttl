PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:S a sh:NodeShape ; sh:targetObjectsOf ex:p ; sh:uniqueMembers true .
ex:a ex:p ( 1 "1" ) , ( ex:x ex:x ) , ex:notAList .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <uniqueMembers-node-001> ) ;
.

<uniqueMembers-node-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: sh:uniqueMembers on focus nodes that are sequences (counterpart of SHACL 1.2 node/uniqueMembers-001); 1 and \"1\" are different terms" ;
  mf:requires ra:Sequences ;
  mf:requires ra:ShaclListConstraints ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode (ex:x ex:x) ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:UniqueMembersConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value (ex:x ex:x) ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:notAList ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:UniqueMembersConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value ex:notAList ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
