PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:ColourShape a sh:NodeShape ; sh:targetClass ex:Swatch ; sh:property ex:ColourShape-rgb .
ex:ColourShape-rgb sh:path ex:rgb ; sh:minCount 1 ; sh:maxCount 1 ;
  sh:minListLength 3 ; sh:maxListLength 3 ; sh:memberShape ex:ByteShape .
ex:ByteShape a sh:NodeShape ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 255 .
ex:red a ex:Swatch ; ex:rgb ( 255 0 0 ) .
ex:pink a ex:Swatch ; ex:rgb ( 255 192 ) .
ex:blue a ex:Swatch ; ex:rgb ( 0 0 256 ) .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <rgb-colour-001> ) ;
.

<rgb-colour-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: an RGB colour: exactly three integers from 0 to 255 (shacl-array.md §2)" ;
  mf:requires ra:Sequences ;
  mf:requires ra:ShaclListConstraints ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:blue ;
          sh:resultPath ex:rgb ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:ColourShape-rgb ;
          sh:value ("0"^^<http://www.w3.org/2001/XMLSchema#integer> "0"^^<http://www.w3.org/2001/XMLSchema#integer> "256"^^<http://www.w3.org/2001/XMLSchema#integer>) ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:pink ;
          sh:resultPath ex:rgb ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinListLengthConstraintComponent ;
          sh:sourceShape ex:ColourShape-rgb ;
          sh:value ("255"^^<http://www.w3.org/2001/XMLSchema#integer> "192"^^<http://www.w3.org/2001/XMLSchema#integer>) ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
