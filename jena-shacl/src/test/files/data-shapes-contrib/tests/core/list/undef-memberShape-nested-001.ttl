PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:IRIShape a sh:NodeShape ; sh:nodeKind sh:IRI .
ex:RowShape a sh:NodeShape ; sh:memberShape ex:IRIShape .
ex:S a sh:NodeShape ; sh:targetObjectsOf ex:p ; sh:memberShape ex:RowShape .
ex:a ex:p ( ( ex:x ) ) , ( ( ex:x undef ) ) .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <undef-memberShape-nested-001> ) ;
.

<undef-memberShape-nested-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: a slot in a nested sequence fails at its own depth; the outer sequence is a value" ;
  mf:requires ra:Sequences ;
  mf:requires ra:ShaclListConstraints ;
  mf:requires ra:UndefSlots ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ((ex:x undef)) ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:S ;
          sh:value ((ex:x undef)) ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
