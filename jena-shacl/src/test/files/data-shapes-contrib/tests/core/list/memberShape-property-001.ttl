PREFIX ex: <http://example/>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX ra: <https://rdf-array.github.io/rdf-array/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sht: <http://www.w3.org/ns/shacl-test#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generated by bin/build.py -- edit the case table there.
ex:IRIShape a sh:NodeShape ; sh:nodeKind sh:IRI .
ex:S a sh:NodeShape ; sh:targetNode ex:a, ex:b, ex:c, ex:d, ex:e ; sh:property ex:S-p .
ex:S-p sh:path ex:p ; sh:memberShape ex:IRIShape .
ex:a ex:p ( ex:x ex:y ) .
ex:b ex:p ( ex:x "s" ) .
ex:c ex:p ex:x .
ex:d ex:p () .
ex:e ex:p ex:l1 .
ex:l1 rdf:first ex:x ; rdf:rest rdf:nil .

<>
  rdf:type mf:Manifest ;
  mf:entries ( <memberShape-property-001> ) ;
.

<memberShape-property-001>
  rdf:type sht:Validate ;
  rdfs:label "rdf-array: sh:memberShape on the values of a property" ;
  mf:requires ra:Sequences ;
  mf:requires ra:ShaclListConstraints ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:b ;
          sh:resultPath ex:p ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:S-p ;
          sh:value (ex:x "s") ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:c ;
          sh:resultPath ex:p ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:S-p ;
          sh:value ex:x ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:e ;
          sh:resultPath ex:p ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:S-p ;
          sh:value ex:l1 ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
