## @base <https://raw.githubusercontent.com/shexSpec/shexTest/master/negativeSyntax-contrib/manifest> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht:    <http://www.w3.org/ns/shacl/test-suite#> .
@prefix sx:     <https://shexspec.github.io/shexTest/ns#> .
@prefix ra:     <https://rdf-array.github.io/rdf-array/vocab#> .

# Generated by bin/build.py -- edit the case table there.

<> a mf:Manifest ;
    rdfs:comment "ShEx-array negative syntax tests: malformed Collection bounds" ;
    mf:entries (
        <#collBoundsStar>
        <#collBoundsNoComma>
        <#collBoundsNoMin>
        <#collBoundsThree>
        <#collBoundsEmpty>
        <#collBoundsUnclosed>
    ) .

<#collBoundsStar> a sht:NegativeSyntax ;
    mf:name "collBoundsStar" ;
    rdfs:comment "a lone * is not a minimum" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collBoundsStar.shex> ;
    .

<#collBoundsNoComma> a sht:NegativeSyntax ;
    mf:name "collBoundsNoComma" ;
    rdfs:comment "the bounds need a comma" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collBoundsNoComma.shex> ;
    .

<#collBoundsNoMin> a sht:NegativeSyntax ;
    mf:name "collBoundsNoMin" ;
    rdfs:comment "the minimum is required" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collBoundsNoMin.shex> ;
    .

<#collBoundsThree> a sht:NegativeSyntax ;
    mf:name "collBoundsThree" ;
    rdfs:comment "at most two bounds" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collBoundsThree.shex> ;
    .

<#collBoundsEmpty> a sht:NegativeSyntax ;
    mf:name "collBoundsEmpty" ;
    rdfs:comment "empty bounds" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collBoundsEmpty.shex> ;
    .

<#collBoundsUnclosed> a sht:NegativeSyntax ;
    mf:name "collBoundsUnclosed" ;
    rdfs:comment "the bounds are not closed" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collBoundsUnclosed.shex> ;
    .
