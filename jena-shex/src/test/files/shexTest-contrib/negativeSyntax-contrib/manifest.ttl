## @base <https://raw.githubusercontent.com/shexSpec/shexTest/master/negativeSyntax-contrib/manifest> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht:    <http://www.w3.org/ns/shacl/test-suite#> .
@prefix sx:     <https://shexspec.github.io/shexTest/ns#> .
@prefix ra:     <https://rdf-array.github.io/rdf-array/vocab#> .

# Generated by bin/build.py -- edit the case table there.

<> a mf:Manifest ;
    rdfs:comment "ShEx-array negative syntax tests: what the LIST grammar rejects" ;
    mf:entries (
        <#listBare>
        <#listEmpty>
        <#listGroupThenAnd>
        <#listComma>
        <#listAfterExtends>
        <#listOldBounds>
        <#undefOr>
        <#undefOrFirst>
        <#undefAnd>
        <#undefNot>
        <#undefValueExpr>
        <#undefDecl>
        <#undefBareList>
    ) .

<#listBare> a sht:NegativeSyntax ;
    mf:name "listBare" ;
    rdfs:comment "a bare LIST x: LIST takes ( regex ) or a cardinality first" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression ;
    sx:shex <listBare.shex> ;
    .

<#listEmpty> a sht:NegativeSyntax ;
    mf:name "listEmpty" ;
    rdfs:comment "LIST ( ) needs at least one member" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression ;
    sx:shex <listEmpty.shex> ;
    .

<#listGroupThenAnd> a sht:NegativeSyntax ;
    mf:name "listGroupThenAnd" ;
    rdfs:comment "inside LIST ( ), ( opens a group, which AND cannot follow; write ( @:T AND @:U )" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression ;
    sx:shex <listGroupThenAnd.shex> ;
    .

<#listComma> a sht:NegativeSyntax ;
    mf:name "listComma" ;
    rdfs:comment "members are joined by ; and |, not by commas" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression ;
    sx:shex <listComma.shex> ;
    .

<#listAfterExtends> a sht:NegativeSyntax ;
    mf:name "listAfterExtends" ;
    rdfs:comment "LIST may not follow EXTENDS" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression ;
    sx:shex <listAfterExtends.shex> ;
    .

<#listOldBounds> a sht:NegativeSyntax ;
    mf:name "listOldBounds" ;
    rdfs:comment "the former ((x))[m, n] spelling is no longer syntax" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression ;
    sx:shex <listOldBounds.shex> ;
    .

<#undefOr> a sht:NegativeSyntax ;
    mf:name "undefOr" ;
    rdfs:comment "undef is not a shape expression: write | " ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression, ra:UndefSlots ;
    sx:shex <undefOr.shex> ;
    .

<#undefOrFirst> a sht:NegativeSyntax ;
    mf:name "undefOrFirst" ;
    rdfs:comment "undef is not a shape expression: it takes no OR" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression, ra:UndefSlots ;
    sx:shex <undefOrFirst.shex> ;
    .

<#undefAnd> a sht:NegativeSyntax ;
    mf:name "undefAnd" ;
    rdfs:comment "undef is not a shape expression: it takes no AND" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression, ra:UndefSlots ;
    sx:shex <undefAnd.shex> ;
    .

<#undefNot> a sht:NegativeSyntax ;
    mf:name "undefNot" ;
    rdfs:comment "undef is not a shape expression: it takes no NOT" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression, ra:UndefSlots ;
    sx:shex <undefNot.shex> ;
    .

<#undefValueExpr> a sht:NegativeSyntax ;
    mf:name "undefValueExpr" ;
    rdfs:comment "undef stands only in place of a list member, not as a value expression" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression, ra:UndefSlots ;
    sx:shex <undefValueExpr.shex> ;
    .

<#undefDecl> a sht:NegativeSyntax ;
    mf:name "undefDecl" ;
    rdfs:comment "undef is not a shape declaration" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression, ra:UndefSlots ;
    sx:shex <undefDecl.shex> ;
    .

<#undefBareList> a sht:NegativeSyntax ;
    mf:name "undefBareList" ;
    rdfs:comment "a bare LIST x, as with any member" ;
    mf:status mf:Proposed ;
    mf:requires ra:ListShapeExpression, ra:UndefSlots ;
    sx:shex <undefBareList.shex> ;
    .
