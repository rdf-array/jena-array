PREFIX sx: <http://www.w3.org/ns/shex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

[] a sx:Schema ;
    sx:shapes ( <http://a.example/T> <http://a.example/S1> ) .

<http://a.example/T> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:TripleConstraint ;
      sx:predicate <http://a.example/q> ;
      sx:valueExpr [ a sx:NodeConstraint ;
        sx:datatype <http://www.w3.org/2001/XMLSchema#integer> ] ] ] .

<http://a.example/S1> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:TripleConstraint ;
      sx:predicate <http://a.example/p1> ;
      sx:valueExpr [ a sx:Collection ;
        sx:shapeExpr [ a sx:Collection ;
          sx:shapeExpr <http://a.example/T> ;
          sx:min 1 ;
          sx:max 1 ] ;
        sx:min 1 ;
        sx:max -1 ] ] ] .

