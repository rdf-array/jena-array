    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collNested.shex> ;
    sx:json <collNested.json> ;
    sx:ttl <collNested.ttl> ;
    .

<#collDot> a sht:RepresentationTest ;
    mf:name "collDot" ;
    rdfs:comment "a sequence of any length of anything" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collDot.shex> ;
    sx:json <collDot.json> ;
    sx:ttl <collDot.ttl> ;
    .

<#collIriOrInt> a sht:RepresentationTest ;
    mf:name "collIriOrInt" ;
    rdfs:comment "a non-empty sequence whose elements are IRIs or integers" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collIriOrInt.shex> ;
