# Generated by bin/build.py -- edit the case table there.

<> a mf:Manifest ;
    rdfs:comment "ShEx-array representation tests: the Collection shape expression in ShExC, ShExJ and ShExR" ;
    mf:entries (
        <#collRef1to2>
        <#collInt>
        <#collInt2>
        <#collInt1Plus>
        <#collNested>
        <#collDot>
        <#collIriOrInt>
        <#collNotInt>
        <#collValueIri>
        <#collColour>
        <#collPolygon>
        <#collPlaylist>
        <#collDecl>
    ) .

<#collRef1to2> a sht:RepresentationTest ;
    mf:name "collRef1to2" ;
    rdfs:comment "a sequence of one or two nodes, each with an integer :q" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collRef1to2.shex> ;
    sx:json <collRef1to2.json> ;
    sx:ttl <collRef1to2.ttl> ;
    .

<#collInt> a sht:RepresentationTest ;
    mf:name "collInt" ;
    rdfs:comment "a sequence of any length (empty included) of integers" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collInt.shex> ;
    sx:json <collInt.json> ;
    sx:ttl <collInt.ttl> ;
    .

<#collInt2> a sht:RepresentationTest ;
    mf:name "collInt2" ;
    rdfs:comment "a sequence of exactly two integers" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collInt2.shex> ;
    sx:json <collInt2.json> ;
    sx:ttl <collInt2.ttl> ;
    .

<#collInt1Plus> a sht:RepresentationTest ;
    mf:name "collInt1Plus" ;
    rdfs:comment "a sequence of one or more integers" ;
    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collInt1Plus.shex> ;
    sx:json <collInt1Plus.json> ;
    sx:ttl <collInt1Plus.ttl> ;
    .

<#collNested> a sht:RepresentationTest ;
    mf:name "collNested" ;
