    mf:status mf:Proposed ;
    mf:requires ra:CollectionShapeExpression ;
    sx:shex <collValueIri.shex> ;
    sx:json <collValueIri.json> ;
    sx:ttl <collValueIri.ttl> ;
    .

<#collColour> a sht:RepresentationTest ;
