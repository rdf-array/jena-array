PREFIX sx: <http://www.w3.org/ns/shex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

[] a sx:Schema ;
    sx:shapes ( <http://a.example/Polygon> ) .

<http://a.example/Polygon> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:TripleConstraint ;
      sx:predicate <http://a.example/points> ;
      sx:valueExpr [ a sx:Collection ;
        sx:shapeExpr [ a sx:Collection ;
          sx:shapeExpr [ a sx:NodeConstraint ;
            sx:datatype <http://www.w3.org/2001/XMLSchema#decimal> ] ;
          sx:min 2 ;
          sx:max 2 ] ;
        sx:min 3 ;
        sx:max -1 ] ] ] .

